{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "google-vertex": {
      "npm": "@ai-sdk/google-vertex",
      "name": "Google Vertex AI (minsky adversarial leg)",
      "options": {"project": "{env:GOOGLE_VERTEX_PROJECT}", "location": "{env:GOOGLE_VERTEX_LOCATION}", "timeout": 1200000},
      "models": {
        "gemini-4-argon": {
          "name": "Gemini 4 Argon @ HIGH thinking (minsky adversarial leg; context window and price UNKNOWN)",
          "reasoning": true,
          "options": {"thinkingConfig": {"thinkingLevel": "high", "includeThoughts": false}}
        }
      }
    }
  }
}
