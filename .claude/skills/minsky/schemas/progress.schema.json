{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mars.local/minsky/progress.schema.json",
  "title": "minsky audit progress event",
  "description": "One JSON-line event in a per-audit NDJSON stream at <repo>/codex-audits/<audit-id>/progress.ndjson. Append-only; atomic per line under the POSIX-atomic O_APPEND limit (512 bytes). See schemas/progress.md for the prose spec and intended use.",
  "type": "object",
  "required": ["ts", "schema_version", "event", "audit_id"],
  "properties": {
    "ts": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp, seconds precision, e.g. '2026-05-03T07:41:40Z'.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "schema_version": {
      "type": "string",
      "description": "Schema version of progress.py at emit time."
    },
    "event": {
      "type": "string",
      "enum": [
        "audit_open",
        "round_start",
        "round_done",
        "step_start",
        "step_done",
        "persona_walk_start",
        "persona_walk_done",
        "converge_done",
        "audit_close",
        "warning",
        "error"
      ]
    },
    "audit_id": {
      "type": "string",
      "minLength": 1,
      "description": "Slug; the canonical audit identifier, also the directory name under codex-audits/."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "event": { "const": "audit_open" } } },
      "then": {
        "properties": {
          "mode": { "type": "string", "enum": ["audit", "plan", "draft", "eval", "bug-hunt"] },
          "scope_kind": { "type": "string", "enum": ["explicit", "delta", "paths", "time"] },
          "branch": { "type": "string" },
          "commit_at_start": { "type": "string", "minLength": 7 },
          "personas": { "type": "array", "items": { "type": "string" } },
          "models": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    {
      "if": { "properties": { "event": { "enum": ["round_start", "round_done"] } } },
      "then": {
        "required": ["round"],
        "properties": {
          "round": { "type": "integer", "minimum": 1 },
          "convergence_status": {
            "type": "string",
            "enum": ["agree", "disagree", "user_override", "incomplete", "abandoned", "paused-rate-limit"],
            "description": "Present on round_done; the converge.py decision for the round."
          }
        }
      }
    },
    {
      "if": { "properties": { "event": { "enum": ["step_start", "step_done"] } } },
      "then": {
        "required": ["step"],
        "properties": {
          "step": {
            "type": "string",
            "enum": ["claude_self", "codex", "opencode", "converge", "claude_synth"]
          },
          "round": { "type": "integer", "minimum": 1 }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "persona_walk_start" } } },
      "then": {
        "required": ["step", "persona"],
        "properties": {
          "step": { "type": "string", "enum": ["claude_self", "codex", "opencode"] },
          "persona": { "type": "string" },
          "model": { "type": "string" },
          "round": { "type": "integer", "minimum": 1 }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "persona_walk_done" } } },
      "then": {
        "required": ["step", "persona", "duration_s", "exit_status"],
        "properties": {
          "step": { "type": "string", "enum": ["claude_self", "codex", "opencode"] },
          "persona": { "type": "string" },
          "model": { "type": "string" },
          "round": { "type": "integer", "minimum": 1 },
          "duration_s": { "type": "number", "minimum": 0 },
          "exit_status": {
            "type": "string",
            "enum": ["ok", "error", "timeout", "rate-limit", "schema-invalid", "usage-invalid", "input-drift", "exit-code-mismatch"],
            "description": "ok = JSON output written, schema-valid, and required provenance complete; every other value is terminal failure and chain.py halts."
          },
          "verdict": {
            "type": "string",
            "enum": ["true", "false", "partial"],
            "description": "Persona's overall verdict on the artifact (from the JSON output's verdict.agree)."
          },
          "finding_count": { "type": "integer", "minimum": 0 },
          "severity_breakdown": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 },
            "description": "Map of severity → count, e.g. {\"critical\":0,\"high\":1,\"medium\":3,\"low\":1}."
          }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "converge_done" } } },
      "then": {
        "required": ["round", "decision"],
        "properties": {
          "round": { "type": "integer", "minimum": 1 },
          "decision": {
            "type": "string",
            "enum": ["agree", "disagree", "user_decision_required", "incomplete"],
            "description": "Mirror of converge.py exit code 0/1/3/2 respectively."
          },
          "unresolved_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "audit_close" } } },
      "then": {
        "required": ["convergence_status"],
        "properties": {
          "convergence_status": {
            "type": "string",
            "enum": ["agree", "disagree", "user_override", "incomplete", "abandoned", "paused-rate-limit"]
          },
          "num_rounds": { "type": "integer", "minimum": 0 },
          "total_findings": { "type": "integer", "minimum": 0 }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "warning" } } },
      "then": {
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "maxLength": 200 },
          "source": { "type": "string", "description": "Emitting script, e.g. 'invoke-opencode.sh'." }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "error" } } },
      "then": {
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "maxLength": 200 },
          "source": { "type": "string" },
          "exit_code": { "type": "integer" }
        }
      }
    }
  ]
}
