  # Last-match semantics: broad allows first, credential denies last.
  read:
    "*": allow
    # EDIT: replace with your research workspace path(s).
    "$HOME/research/**": allow
    "$HOME/.ssh/**": deny
    "$HOME/.gnupg/**": deny
    "$HOME/.aws/**": deny
    "$HOME/.codex/auth.json": deny
    "$HOME/.claude/auth.json": deny
    "$HOME/Library/**": deny
    "**/.env": deny
    "**/.env.*": deny
    "**/credentials": deny
    "**/.netrc": deny

  # Cross-cutting gate for any tool touching paths outside cwd.
  external_directory:
    # EDIT: same paths as the `read:` allow rules above.
    "$HOME/research/**": allow
    "$HOME/.ssh/**": deny
    "$HOME/.gnupg/**": deny
    "$HOME/.aws/**": deny
